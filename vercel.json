{
  "services": {
    "my_frontend": {
      "root": "frontend/"
    },
    "my_backend": {
      "root": "backend/",
      "entrypoint": "app.py"
    }
  },
  "rewrites": [
    {
      "source": "/orders(.*)",
      "destination": { "service": "my_backend" }
    },
    {
      "source": "/dashboard(.*)",
      "destination": { "service": "my_backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "my_frontend" }
    }
  ]
}
